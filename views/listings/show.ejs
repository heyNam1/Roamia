<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow border-0 rounded-4">
        <!-- Image -->
        <% if (listing.image && listing.image.trim() !== "") { %>
        <img
          src="<%= listing.image %>"
          alt="<%= listing.title %>"
          class="card-img-top rounded-top-4"
          style="object-fit: cover; height: 300px"
        />
        <% } else { %>
        <div class="bg-light text-center py-5 rounded-top-4 text-muted">
          No image available
        </div>
        <% } %>

        <!-- Details -->
        <div class="card-body p-4">
          <h2 class="card-title fw-semibold mb-3 text-dark">
            <%= listing.title %>
          </h2>
          <p class="text-secondary mb-4"><%= listing.description %></p>

          <ul class="list-unstyled small mb-4">
            <li>
              <strong>💰 Price:</strong>
              ₹<%= listing.price.toLocaleString("en-IN") %>
            </li>
            <li><strong>📍 Location:</strong> <%= listing.location %></li>
            <li><strong>🌏 Country:</strong> <%= listing.country %></li>
          </ul>

          <!-- Buttons -->
          <div class="d-flex justify-content-between align-items-center">
            <a
              href="/listings/<%= listing._id %>/edit"
              class="btn btn-outline-dark btn-sm px-3"
            >
              <i class="fa-solid fa-pen me-1"></i> Edit
            </a>

            <form
              method="POST"
              action="/listings/<%= listing._id %>?_method=DELETE"
              onsubmit="return confirm('Are you sure you want to delete this listing?');"
            >
              <button class="btn btn-danger btn-sm px-3">
                <i class="fa-solid fa-trash me-1"></i> Delete
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
