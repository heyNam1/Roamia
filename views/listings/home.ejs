<% layout("layouts/boilerplate") %>

<div class="container mt-5">
  <div class="p-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-5">
      <h1 class="display-4 fw-bold">Welcome to Roamia</h1>

      <p class="col-md-8 fs-5">
        Discover amazing places to stay and explore beautiful destinations.
      </p>

      <a href="/listings" class="btn btn-dark btn-lg"> Explore Listings </a>
    </div>
  </div>

  <h2 class="mb-4">Why Roamia?</h2>

  <div class="row">
    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h4>🏠 Amazing Places</h4>
          <p>Find unique places for your next trip.</p>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h4>🌍 Explore</h4>
          <p>Discover destinations around the world.</p>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h4>✨ Easy Booking</h4>
          <p>Find and manage your favorite listings easily.</p>
        </div>
      </div>
    </div>
  </div>
</div>
